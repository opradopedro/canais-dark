 "lineas": [
  {
   "texto": "Imagine your bus stops at a town that *isn't on any map*.",
   "pausa": 0.5
  },
  {
   "texto": "Nora, twenty-nine, works late shifts at a clinic in Oregon.",
   "pausa": 0.5
  },
  {
   "texto": "Every night she takes the last bus home, at 11:40.",
   "pausa": 0.5
  },
  {
   "texto": "Twenty minutes. Same seat, same stops.",
   "pausa": 0.5
  },
  {
   "texto": "Tonight she falls asleep for a second, and wakes up alone.",
   "pausa": 0.5
  },
  {
   "texto": "No passengers. Trees on both sides.",
   "pausa": 0.5
  },
  {
   "texto": "Her phone says she has been riding for *forty minutes*.",
   "pausa": 0.5
  },
  {
   "texto": "The bus hasn't stopped once. The driver won't look back.",
   "pausa": 0.5
  },
  {
   "texto": "Stay, because what she posted next is still online.",
   "pausa": 0.5
  },
  {
   "texto": "She opens a local forum and types: is there a stop called nothing?",
   "pausa": 0.5
  },
  {
   "texto": "Someone answers in seconds: get off at the next stop. Don't argue.",
   "pausa": 0.5
  },
  {
   "texto": "The bus slows down. The sign on the shelter says *Hollow Pines*.",
   "pausa": 0.5
  },
  {
   "texto": "She checks the map. The blue dot is in the middle of a forest.",
   "pausa": 0.5
  },
  {
   "texto": "The driver opens the doors and says: end of the line.",
   "pausa": 0.5
  },
  {
   "texto": "She steps out, and the bus leaves with every light switched off.",
   "pausa": 0.5
  },
  {
   "texto": "The road is silent. Then she sees the shelter isn't empty.",
   "pausa": 0.5
  },
  {
   "texto": "A man sits on the bench, perfectly still. He *has no face*.",
   "pausa": 0.8
  },
  {
   "texto": "And he says her name. Part two, {when_next}.",
   "pausa": 0.3
  }
 ],
