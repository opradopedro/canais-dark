      "u": 0.5
     }
    ]
   }
  },
  {
   "texto": "Lock the gates at ten. If you hear digging, it isn't yours.",
   "pausa": 0.5,
   "cena": {
    "fundo": "cemiterio-entrada",
    "cam": {
     "z": [
      1.15,
      1.3
     ],
     "x": 0.5,
     "y": 0.6
    },
    "fx": [
     "escuro"
    ],
    "atores": [
     {
      "id": "eli",
      "pose": "apontar",
      "rosto": "calmo",
      "v": 0.93,
      "esc": 1.0,
      "u": 0.5
     }
    ]
   }
  },
  {
   "texto": "Never step on *fresh dirt* after midnight.",
