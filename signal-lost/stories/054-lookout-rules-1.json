     }
    ]
   }
  },
  {
   "texto": "Nell, thirty-four, is a fire lookout, alone above the trees.",
   "pausa": 0.5,
   "cena": {
    "fundo": "floresta-pe_torre-dia",
    "cam": {
     "z": [
      1.0,
      1.12
     ],
