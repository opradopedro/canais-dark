      "pose": "apontar",
      "rosto": "determinado",
      "v": 0.93,
      "esc": 1.0,
      "u": 0.5
     }
    ]
   }
  },
  {
   "texto": "If you see a fire with no smoke, don't report it.",
   "pausa": 0.5,
   "cena": {
    "fundo": "floresta-fundo",
    "cam": {
     "z": [
      1.12,
      1.0
     ],
     "x": 0.5,
     "y": 0.55
    },
    "fx": [
     "escuro"
    ]
   }
  },
  {
   "texto": "If you hear steps at night, lock the hatch, stay quiet.",
   "pausa": 0.5,
   "cena": {
    "fundo": "casa_interior-porta",
    "cam": {
     "z": [
      1.2,
      1.32
     ],
