      "pose": "parado",
      "rosto": "calmo",
      "v": 0.93,
      "esc": 1.0,
      "u": 0.5
     }
    ]
   }
  },
  {
   "texto": "He left three rules taped to the radio.",
   "pausa": 0.5,
   "cena": {
    "fundo": "casa_interior-sala-dia",
    "cam": {
     "z": [
      1.45,
      1.6
