      "rosto": "sorriso",
      "v": 0.93,
      "esc": 1.0,
      "u": 0.5
     }
    ]
   }
  },
  {
   "texto": "The last lookout quit in the middle of the season.",
   "pausa": 0.5,
   "cena": {
    "fundo": "casa_interior-sala-dia",
    "cam": {
     "z": [
      1.3,
      1.15
     ],
     "x": 0.5,
