      "esc": 1.08,
      "vira": 1
     }
    ]
   }
  },
  {
   "texto": "Owen looks through the curtain. Something is walking down the middle of the street.",
   "pausa": 0.5,
   "cena": {
    "fundo": "casa_interior-janela",
    "cam": {
     "z": [
      1.45,
