      "pose": "parado",
      "rosto": "calmo",
      "u": 0.5,
      "v": 0.93,
      "esc": 1.35,
      "vira": 1
     }
    ]
   }
  },
  {
   "texto": "Owen, twenty-nine, just moved to a mountain town founded by Austrians.",
   "pausa": 0.5,
   "cena": {
    "fundo": "bairro-rua-dia",
    "cam": {
     "z": [
      1.12,
      1.26
     ],
     "x": 0.5,
     "y": 0.6
    },
    "fx": [],
    "atores": [
     {
      "id": "owen",
      "pose": "andar",
      "rosto": "calmo",
      "v": 0.93,
      "esc": 1.0,
      "u": 0.5
     }
    ]
   }
  },
  {
   "texto": "On his first winter, the neighbors hand him a bundle of birch sticks.",
   "pausa": 0.5,
   "cena": {
    "fundo": "bairro-frente_casa-dia",
    "cam": {
     "z": [
      1.3,
      1.15
     ],
     "x": 0.5,
     "y": 0.6
    },
    "fx": [],
    "atores": [
     {
      "id": "price",
      "pose": "apontar",
      "rosto": "sorriso",
      "v": 0.93,
      "esc": 1.0,
      "u": 0.32
     },
     {
      "id": "owen",
      "pose": "parado",
      "rosto": "determinado",
      "v": 0.93,
      "esc": 1.0,
      "u": 0.68
     }
    ]
   }
  },
  {
   "texto": "Put it on your porch before dark, they say. And three rules.",
   "pausa": 0.5,
   "cena": {
    "fundo": "bairro-frente_casa-dia",
    "cam": {
     "z": [
      1.45,
      1.6
     ],
     "x": 0.5,
     "y": 0.58
    },
    "fx": [],
    "atores": [
     {
      "id": "price",
      "pose": "apontar",
      "rosto": "determinado",
      "v": 0.93,
      "esc": 1.0,
      "u": 0.5
     }
    ]
   }
  },
  {
   "texto": "Bells mean stay inside. Never answer someone asking for the naughty ones.",
   "pausa": 0.5,
   "cena": {
    "fundo": "bairro-calcada-dia",
    "cam": {
     "z": [
      1.26,
      1.12
     ],
     "x": 0.5,
     "y": 0.6
    },
    "fx": [
     "dourado"
    ],
    "atores": [
     {
      "id": "price",
      "pose": "parado",
      "rosto": "medo",
      "v": 0.93,
      "esc": 1.0,
      "u": 0.5
     }
    ]
   }
  },
  {
   "texto": "And never, ever take the sticks back in.",
   "pausa": 0.5,
   "cena": {
    "fundo": "bairro-frente_casa-dia",
    "cam": {
     "z": [
      1.3,
      1.45
     ],
     "x": 0.5,
     "y": 0.58
    },
    "fx": [
     "dourado"
    ],
    "atores": [
     {
      "id": "price",
      "pose": "apontar",
      "rosto": "raiva",
      "v": 0.93,
      "esc": 1.0,
      "u": 0.5
     }
    ]
   }
  },
  {
   "texto": "Owen laughs. Like Santa, but with a goat.",
   "pausa": 0.5,
   "cena": {
    "fundo": "casa_interior-sala",
    "cam": {
     "z": [
      1.3,
