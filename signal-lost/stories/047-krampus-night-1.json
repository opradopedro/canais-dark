      "v": 0.93,
      "esc": 1.0,
      "u": 0.5
     }
    ]
   }
  },
  {
   "texto": "At eleven, the whole street goes dark. Every porch has its bundle.",
   "pausa": 0.5,
   "cena": {
    "fundo": "bairro-rua",
    "cam": {
     "z": [
      1.0,
      1.12
     ],
     "x": 0.5,
     "y": 0.55
    },
    "fx": [
     "escuro"
    ]
   }
  },
  {
   "texto": "Stay, because at midnight, the bells started.",
   "pausa": 0.5,
   "cena": {
    "fundo": "casa_interior-janela",
    "cam": {
     "z": [
      1.6,
