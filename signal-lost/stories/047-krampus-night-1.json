      "rosto": "calmo",
      "u": 0.5,
      "v": 0.93,
      "esc": 1.55
     }
    ]
   }
  },
  {
   "texto": "Because on December fifth, something comes to collect the people who did.",
   "pausa": 0.5,
   "cena": {
    "fundo": "bairro-rua",
    "cam": {
     "z": [
      1.32,
      1.2
     ],
