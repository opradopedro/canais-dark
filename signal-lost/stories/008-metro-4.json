 "lineas": [
  {
   "texto": "Part four. We stood in a circle, four flashlights pointing out.",
   "pausa": 0.8,
   "vel": 0.88
  },
  {
   "texto": "Something knocked on the window. A man in a driver's uniform, down on the tracks.",
   "pausa": 0.8
  },
  {
   "texto": "He smiled and said: the cab is safe. Open the window and climb out.",
   "pausa": 0.9,
   "vel": 0.84
  },
  {
   "texto": "Then the intercom crackled: this is your driver. I never left my cab. Don't open anything.",
   "pausa": 1.0,
   "vel": 0.82
  },
  {
   "texto": "We didn't. He knocked until five in the morning.",
   "pausa": 0.7
  },
  {
   "texto": "At 5:03, the train moved.",
   "pausa": 0.8
  },
  {
   "texto": "At the next station, the front car was full again. Every face pressed to the glass. Looking at us.",
   "pausa": 1.0,
   "vel": 0.8
  },
  {
   "texto": "If your train ever stops in a tunnel, count yourselves. And never let it get dark.",
   "pausa": 0.4,
   "vel": 0.84
  }
 ],
