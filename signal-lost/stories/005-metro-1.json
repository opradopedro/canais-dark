 "lineas": [
  {
   "texto": "Our train stopped in the tunnel at 11:52, between two stations.",
   "pausa": 0.8,
   "vel": 0.88
  },
  {
   "texto": "Through the glass door, I could see the front car. Packed. Standing room only.",
   "pausa": 0.7
  },
  {
   "texto": "Then every light on the train went out.",
   "pausa": 0.9,
   "vel": 0.85
  },
  {
   "texto": "Ten seconds. Then they flickered back on.",
   "pausa": 0.7
  },
  {
   "texto": "The front car was empty. Every seat. Every pole.",
   "pausa": 0.9,
   "vel": 0.84
  },
  {
   "texto": "Nobody walked past us. There was nowhere to go.",
   "pausa": 0.7
  },
  {
   "texto": "Then the intercom clicked on, and someone up front was breathing.",
   "pausa": 1.0,
   "vel": 0.82
  },
  {
   "texto": "Part two, {when_next}.",
   "pausa": 0.3,
   "vel": 0.88
  }
