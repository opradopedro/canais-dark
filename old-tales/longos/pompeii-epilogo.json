      "pose": "apontar",
      "rosto": "determinado",
      "v": 0.93,
      "esc": 1.0,
      "arma": false,
      "u": 0.5
     }
    ]
   }
  },
  {
   "texto": "They are the only eyewitness account of the eruption that survived.",
   "pausa": 0.4,
   "cena": {
    "fundo": "grecia_templo-escada",
    "cam": {
     "z": [
      1.45,
      1.3
     ],
