      "esc": 1.0,
      "arma": false,
      "u": 0.68
     }
    ]
   }
  },
  {
   "texto": "Pliny the Younger wrote two letters to the historian Tacitus, about twenty-five years later.",
   "pausa": 0.4,
   "cena": {
    "fundo": "grecia_templo-templo",
    "cam": {
     "z": [
      1.15,
      1.3
     ],
