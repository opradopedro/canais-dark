     "y": 0.6
    },
    "fx": [],
    "atores": [
     {
      "id": "arqueologa",
      "pose": "parado",
      "rosto": "determinado",
      "v": 0.93,
      "esc": 1.0,
      "arma": false,
      "u": 0.5
     }
    ]
   }
  },
  {
   "texto": "But in twenty eighteen, archaeologists found a charcoal note on a wall.",
   "pausa": 0.4,
   "cena": {
    "fundo": "esparta_cidade-casa",
    "cam": {
     "z": [
      1.45,
      1.6
     ],
