      "rosto": "sorriso",
      "v": 0.93,
      "esc": 1.0,
      "arma": false,
      "u": 0.5
     }
    ]
   }
  },
  {
   "texto": "How many died? About eleven hundred victims have been found in Pompeii.",
   "pausa": 0.4,
   "cena": {
    "fundo": "campo_batalha-pe_torre",
    "cam": {
     "z": [
      1.3,
      1.15
