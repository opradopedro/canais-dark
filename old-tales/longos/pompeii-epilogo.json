      "rosto": "sorriso",
      "v": 0.93,
      "esc": 1.0,
      "arma": false,
      "u": 0.5
     }
    ]
   }
  },
  {
   "texto": "Dated mid-October, written in a house still being repaired.",
   "pausa": 0.4,
   "cena": {
    "fundo": "esparta_cidade-templo",
    "cam": {
     "z": [
      1.3,
      1.15
     ],
     "x": 0.5,
     "y": 0.6
    },
    "fx": [],
    "atores": [
     {
      "id": "arqueologa",
      "pose": "apontar",
      "rosto": "determinado",
      "v": 0.93,
      "esc": 1.0,
      "arma": false,
      "u": 0.5
     }
    ]
   }
  },
  {
   "texto": "Add autumn fruits found in the ruins, and many experts now think it was October.",
   "pausa": 0.4,
   "cena": {
    "fundo": "esparta_cidade-mercado",
    "cam": {
     "z": [
      1.15,
      1.3
