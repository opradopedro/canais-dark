      "v": 0.93,
      "esc": 1.0,
      "arma": false,
      "u": 0.5
     }
    ]
   }
  },
  {
   "texto": "In them, the umbrella pine cloud, the pillows on heads, and his uncle's last voyage.",
   "pausa": 0.4,
   "cena": {
    "fundo": "mar_jangada-proa-tempestade",
    "cam": {
     "z": [
      1.15,
      1.3
     ],
     "x": 0.5,
     "y": 0.6
    },
    "fx": [
