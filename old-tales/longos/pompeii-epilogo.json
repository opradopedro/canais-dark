      "v": 0.93,
      "esc": 1.0,
      "arma": false,
      "u": 0.5
     }
    ]
   }
  },
  {
   "texto": "Pliny the Elder died on the beach at Stabiae, probably from the fumes, or his heart.",
   "pausa": 0.4,
   "cena": {
    "fundo": "mar_jangada-horizonte-tempestade",
    "cam": {
     "z": [
      1.12,
      1.0
