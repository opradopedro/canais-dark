      "v": 0.93,
      "esc": 1.0,
      "arma": false,
      "u": 0.5
     }
    ]
   }
  },
  {
   "texto": "And many died on the roads, never counted.",
   "pausa": 0.4,
   "cena": {
    "fundo": "campo_batalha-meio",
    "cam": {
     "z": [
      1.12,
      1.0
     ],
     "x": 0.5,
     "y": 0.55
    },
    "fx": []
   }
  },
  {
   "texto": "In Herculaneum, the boathouses held more than three hundred skeletons, found in the nineteen eighties and nineties.",
   "pausa": 0.4,
   "cena": {
    "fundo": "campo_batalha-acostamento-noite",
    "cam": {
     "z": [
      1.15,
      1.3
     ],
     "x": 0.5,
