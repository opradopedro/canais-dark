      "rosto": "triste",
      "v": 0.93,
      "esc": 1.0,
      "arma": false,
      "u": 0.5
     }
    ]
   }
  },
  {
   "texto": "He was fifty-six, and the author of the biggest encyclopedia of the ancient world.",
   "pausa": 0.4,
   "cena": {
    "fundo": "grecia_templo-templo",
    "cam": {
     "z": [
      1.45,
      1.6
     ],
