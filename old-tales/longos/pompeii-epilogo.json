    ],
    "cartao": {
     "tipo": "fato",
     "titulo": "Victims found in Pompeii",
     "valor": "~1,100",
     "sub": "a third of the city still buried",
     "t0": 0.4
    }
   }
  },
  {
   "texto": "But a third of the city is still unexcavated.",
   "pausa": 0.4,
   "cena": {
    "fundo": "esparta_cidade-praca",
    "cam": {
     "z": [
      1.0,
      1.12
     ],
