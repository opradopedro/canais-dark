    "cartao": {
     "tipo": "nome",
     "titulo": "Pliny the Elder",
     "sub": "23-79 AD, Natural History",
     "t0": 0.4
    }
   }
  },
  {
   "texto": "What about the date? For centuries, schoolbooks said August twenty-fourth.",
   "pausa": 0.4,
   "cena": {
    "fundo": "esparta_cidade-casa",
    "cam": {
     "z": [
      1.3,
      1.15
     ],
