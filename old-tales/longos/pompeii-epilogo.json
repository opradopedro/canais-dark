      "pose": "agachar",
      "rosto": "triste",
      "v": 0.93,
      "esc": 1.0,
      "arma": false,
      "u": 0.5
     }
    ]
   }
  },
  {
   "texto": "Their bones let scientists measure the heat. Hundreds of degrees, in seconds.",
   "pausa": 0.4,
   "cena": {
    "fundo": "campo_batalha-vindo-tempestade",
    "cam": {
     "z": [
      1.12,
