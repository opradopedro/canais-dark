      "v": 0.93,
      "esc": 1.0,
      "arma": false,
      "u": 0.5
     }
    ]
   }
  },
  {
   "texto": "King Leonidas made his choice.",
   "pausa": 0.5,
   "cena": {
    "fundo": "esparta_cidade-escada",
    "cam": {
     "z": [
      1.15,
      1.3
