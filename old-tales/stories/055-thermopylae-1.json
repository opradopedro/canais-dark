    "cartao": {
     "tipo": "nome",
     "titulo": "King Leonidas",
     "sub": "of Sparta",
     "t0": 0.4
    }
   }
  },
  {
   "texto": "Stay, because the way he picked his men tells you everything.",
   "pausa": 0.5,
   "cena": {
    "fundo": "esparta_cidade-casa",
