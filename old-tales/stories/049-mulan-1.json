      "esc": 1.0,
      "arma": "lanca",
      "u": 0.5
     }
    ]
   }
  },
  {
   "texto": "Mulan's father was old, and too sick to hold a sword.",
   "pausa": 0.5,
   "cena": {
    "fundo": "aldeia_china-casa",
    "cam": {
     "z": [
      1.26,
      1.12
