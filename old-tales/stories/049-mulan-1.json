      "pose": "susto",
      "rosto": "triste",
      "v": 0.93,
      "esc": 1.0,
      "arma": false,
      "u": 0.5
     }
    ]
   }
  },
  {
   "texto": "He had no grown son. She had no older brother.",
   "pausa": 0.5,
   "cena": {
