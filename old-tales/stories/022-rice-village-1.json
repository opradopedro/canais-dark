 "lineas": [
  {
   "texto": "You wake up in Japan, in the year 1700. You grow rice.",
   "pausa": 0.6
  },
  {
   "texto": "Your village has about three hundred people.",
   "pausa": 0.6
  },
  {
   "texto": "Here, rice is money. Your lord counts his wealth in koku.",
   "pausa": 0.6
  },
  {
   "texto": "One koku is enough rice to feed one person for a year.",
   "pausa": 0.6
  },
  {
   "texto": "Your house belongs to a group of five families.",
   "pausa": 0.6
  },
  {
   "texto": "If one family breaks the law, all five are punished.",
   "pausa": 0.8
  },
  {
   "texto": "So everyone watches everyone. Politely.",
   "pausa": 0.6
  },
  {
   "texto": "And this spring, your neighbor is acting strange. Part two, {when_next}.",
   "pausa": 0.3
  }
