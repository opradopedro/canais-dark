      "esc": 1.0,
      "arma": "espada",
      "u": 0.5
     }
    ]
   }
  },
  {
   "texto": "Her commanders died, one after another.",
   "pausa": 0.5,
   "cena": {
    "fundo": "campo_batalha-curva-tempestade",
