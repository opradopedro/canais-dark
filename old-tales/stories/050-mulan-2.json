      "v": 0.93,
      "esc": 1.0,
      "arma": false,
      "u": 0.5
     }
    ],
    "cartao": {
     "tipo": "fato",
     "titulo": "The road to the frontier",
     "valor": "10,000 li",
     "sub": "about 5,000 km on horseback",
     "t0": 0.4
    }
   }
  },
  {
   "texto": "The northern wind froze the iron of her armor at night.",
   "pausa": 0.5,
   "cena": {
    "fundo": "campo_batalha-pe_torre-neve",
    "cam": {
     "z": [
      1.15,
      1.3
     ],
     "x": 0.5,
     "y": 0.6
    },
    "fx": [
     "neblina"
    ],
    "atores": [
     {
      "id": "mulan",
      "pose": "parado",
      "rosto": "triste",
      "v": 0.93,
      "esc": 1.0,
      "arma": "lanca",
      "u": 0.5
     }
    ]
   }
  },
  {
   "texto": "The poem says the cold light shone on the metal, and the night gong rang in the frost.",
   "pausa": 0.5,
   "cena": {
    "fundo": "campo_batalha-pe_torre-neve",
    "cam": {
     "z": [
      1.6,
      1.45
     ],
     "x": 0.5,
     "y": 0.58
    },
    "fx": [
     "neblina"
    ],
    "atores": [
     {
      "id": "mulan",
      "pose": "lutar",
      "rosto": "calmo",
      "v": 0.93,
      "esc": 1.0,
      "arma": "lanca",
      "u": 0.5
     }
    ]
   }
  },
  {
   "texto": "She slept beside men who would kill her if they knew.",
   "pausa": 0.5,
   "cena": {
    "fundo": "campo_batalha-acostamento-noite",
    "cam": {
     "z": [
      1.12,
      1.26
     ],
     "x": 0.5,
     "y": 0.6
    },
    "fx": [
     "escuro"
    ],
    "atores": [
     {
      "id": "mulan",
      "pose": "agachar",
      "rosto": "determinado",
      "v": 0.93,
      "esc": 1.0,
      "arma": false,
      "u": 0.32
     },
     {
      "id": "general",
      "pose": "agachar",
      "rosto": "sorriso",
      "v": 0.93,
      "esc": 1.0,
      "arma": false,
      "u": 0.68
     }
    ]
   }
  },
  {
   "texto": "She bathed alone. She spoke low. She never laughed too loud.",
   "pausa": 0.5,
   "cena": {
    "fundo": "campo_batalha-beira_mato-noite",
    "cam": {
     "z": [
      1.6,
      1.45
     ],
     "x": 0.5,
     "y": 0.58
    },
    "fx": [
     "escuro"
    ],
    "atores": [
     {
      "id": "mulan",
      "pose": "parado",
      "rosto": "determinado",
      "v": 0.93,
      "esc": 1.0,
      "arma": false,
      "u": 0.5
     }
    ]
   }
  },
  {
   "texto": "Then the riders came over the hills.",
   "pausa": 0.5,
   "cena": {
    "fundo": "campo_batalha-indo-tempestade",
    "cam": {
     "z": [
      1.2,
      1.32
