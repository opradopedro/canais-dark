     "x": 0.5,
     "y": 0.66
    },
    "fx": [
     "chuva"
    ]
   }
  },
  {
   "texto": "Stay, because the poem hides the battles in just one line.",
   "pausa": 0.5,
   "cena": {
    "fundo": "campo_batalha-meio-tempestade",
    "cam": {
     "z": [
      1.08,
