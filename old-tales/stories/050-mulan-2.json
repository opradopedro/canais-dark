      "u": 0.5
     }
    ]
   }
  },
  {
   "texto": "Mulan fought in the front line, and she didn't fall.",
   "pausa": 0.5,
   "cena": {
    "fundo": "campo_batalha-meio-tempestade",
    "cam": {
     "z": [
      1.2,
