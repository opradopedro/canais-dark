      "v": 0.93,
      "esc": 1.0,
      "arma": "escudo",
      "u": 0.68
     }
    ]
   }
  },
  {
   "texto": "The Persians have so many archers, their arrows will hide the sun.",
   "pausa": 0.5,
   "cena": {
    "fundo": "campo_batalha-vindo-tempestade",
    "cam": {
     "z": [
      1.2,
      1.32
     ],
     "x": 0.5,
     "y": 0.66
    },
    "fx": [
     "chuva"
    ]
   }
  },
  {
   "texto": "A Spartan named Dienekes only shrugged.",
   "pausa": 0.5,
   "cena": {
    "fundo": "campo_batalha-meio",
    "cam": {
     "z": [
      1.6,
      1.45
     ],
     "x": 0.5,
     "y": 0.58
    },
    "fx": [],
    "atores": [
     {
      "id": "dienekes",
      "pose": "parado",
      "rosto": "sorriso",
      "v": 0.93,
      "esc": 1.0,
      "arma": "escudo",
      "u": 0.5
     }
    ],
    "cartao": {
     "tipo": "nome",
     "titulo": "Dienekes",
     "sub": "Spartan soldier",
     "t0": 0.4
    }
   }
  },
  {
   "texto": "Good. Then we will fight *in the shade*.",
   "pausa": 0.5,
   "cena": {
    "fundo": "campo_batalha-meio",
    "cam": {
     "z": [
      1.2,
