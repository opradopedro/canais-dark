      "esc": 1.15,
      "arma": "espada",
      "u": 0.5
     }
    ]
   }
  },
  {
   "texto": "A local man warned the Greeks what was coming.",
   "pausa": 0.5,
   "cena": {
    "fundo": "campo_batalha-acostamento",
    "cam": {
     "z": [
