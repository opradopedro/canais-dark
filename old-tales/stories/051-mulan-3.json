      "esc": 1.0,
      "arma": false,
      "u": 0.5
     }
    ]
   }
  },
  {
   "texto": "And she refused.",
   "pausa": 0.5,
   "cena": {
    "fundo": "palacio_ceu-salao",
    "cam": {
     "z": [
      1.32,
