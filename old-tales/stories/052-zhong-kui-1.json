    ],
    "atores": [
     {
      "id": "zhongkui",
      "pose": "cair",
      "rosto": "triste",
      "v": 0.93,
      "esc": 1.0,
      "arma": false,
      "u": 0.5
     }
    ]
   }
  },
  {
   "texto": "Du Ping carried his body home and buried him with honor.",
   "pausa": 0.8,
   "cena": {
    "fundo": "aldeia_china-templo-tempestade",
    "cam": {
