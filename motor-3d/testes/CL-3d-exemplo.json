 "lineas": [
  { "texto": "In an old village, the day begins before the sun.", "pausa": 0.6 },
  { "texto": "Tomas the miller wakes when the roosters call.", "pausa": 0.5 },
  { "texto": "He walks past the quiet well to the mill.", "pausa": 0.5 },
  { "texto": "The great wheel turns slowly in the cold stream.", "pausa": 0.6 },
  { "texto": "Inside, he grinds the golden wheat into flour.", "pausa": 0.5 },
  { "texto": "A small boy brings a sack from the far farm.", "pausa": 0.5 },
  { "texto": "They share warm bread by the market stall.", "pausa": 0.6 },
  { "texto": "The baker waves from across the muddy square.", "pausa": 0.5 },
  { "texto": "By noon, the whole village smells of fresh loaves.", "pausa": 0.5 },
  { "texto": "At dusk, Tomas rests on a bench by the inn.", "pausa": 0.6 },
  { "texto": "The hills turn gold, then soft and blue.", "pausa": 0.5 },
  { "texto": "Nothing happened today, and that was enough.", "pausa": 0.6 },
  { "texto": "Would you trade your busy day for his?", "pausa": 0.7 }
 ],
