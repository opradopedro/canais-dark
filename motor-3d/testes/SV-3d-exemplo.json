 "lineas": [
  { "texto": "Imagine a forest where one rule keeps you alive.", "pausa": 0.5 },
  { "texto": "Never leave the tower after the sun goes down.", "pausa": 0.5 },
  { "texto": "By day, it looks like an ordinary lookout.", "pausa": 0.5 },
  { "texto": "But when the night comes, the trees start to move.", "pausa": 0.6 },
  { "texto": "Cal was new, and he thought the rule was silly.", "pausa": 0.5 },
  { "texto": "So one night, he took his lantern and climbed down.", "pausa": 0.5 },
  { "texto": "The rain was cold, and the radio only hissed.", "pausa": 0.5 },
  { "texto": "Stay with me, because now it gets scary.", "pausa": 0.6 },
  { "texto": "Between the pines, something tall was watching him.", "pausa": 0.6 },
  { "texto": "It had no face, only two slow yellow eyes.", "pausa": 0.6 },
  { "texto": "Cal ran back up the stairs and shut the door.", "pausa": 0.5 },
  { "texto": "At dawn, the forest was quiet and empty again.", "pausa": 0.5 },
  { "texto": "The rule had kept him alive one more night.", "pausa": 0.5 },
  { "texto": "But the rain is washing the warning off the wall.", "pausa": 0.6 },
  { "texto": "What happens on the night nobody remembers the rule?", "pausa": 0.7 }
 ],
