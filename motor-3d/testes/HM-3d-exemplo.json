 "lineas": [
  { "texto": "Imagina un barrio rodeado por una raya blanca en el suelo.", "pausa": 0.6 },
  { "texto": "Nadie cruza la raya cuando cae la noche.", "pausa": 0.5 },
  { "texto": "De dia, los ninos juegan en la calle sin miedo.", "pausa": 0.5 },
  { "texto": "Pero cuando oscurece, algo camina entre los arboles.", "pausa": 0.6 },
  { "texto": "Mateo no creia en esas cosas de viejos.", "pausa": 0.5 },
  { "texto": "Una noche salio con su linterna a cruzar la raya.", "pausa": 0.5 },
  { "texto": "Empezo a llover, y los postes parpadeaban.", "pausa": 0.5 },
  { "texto": "Quedate, porque ahora viene lo que da miedo.", "pausa": 0.6 },
  { "texto": "Entre los pinos, una sombra muy alta lo miraba.", "pausa": 0.6 },
  { "texto": "No tenia cara, solo dos ojos amarillos.", "pausa": 0.6 },
  { "texto": "Mateo corrio de vuelta y no cruzo la raya.", "pausa": 0.5 },
  { "texto": "Al amanecer, el barrio estaba tranquilo otra vez.", "pausa": 0.5 },
  { "texto": "La raya lo habia salvado una noche mas.", "pausa": 0.5 },
  { "texto": "Pero la lluvia esta borrando la raya del suelo.", "pausa": 0.6 },
  { "texto": "Que pasara la noche en que la raya desaparezca?", "pausa": 0.7 }
 ],
