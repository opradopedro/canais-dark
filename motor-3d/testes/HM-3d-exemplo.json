 "titulo": "La calle de la raya blanca (prueba 3D)",
 "elenco": {
  "mateo": { "altura": 1.7, "pele": "#c98d5f", "camisa": "#6a2b22", "calca": "#241810", "cabelo": "curto", "cabelo_cor": "#1a120a" }
