 "mundo": "cidade",
 "autor": "claude",
 "lineas": [
  {
   "texto": "Your city's main avenue is jammed every morning, and the buses can't move.",
   "pausa": 0.3
  },
  {
   "texto": "So you decide to run trains under the street.",
   "pausa": 0.3
  },
  {
   "texto": "The cheapest way: close the avenue, rip it open, and dig a trench.",
   "pausa": 0.3
  },
  {
   "texto": "But at four meters, the dirt walls slide into the hole.",
   "pausa": 0.3
  },
  {
   "texto": "So before digging, you pour concrete walls deep into the ground.",
   "pausa": 0.3
  },
  {
   "texto": "Then you dig out the dirt between them.",
   "pausa": 0.3
  },
  {
   "texto": "But the soil pushes so hard that the walls start bending inward.",
   "pausa": 0.3
  },
  {
   "texto": "So you brace them with steel struts across the trench.",
   "pausa": 0.3
  },
  {
   "texto": "Then, seven meters down, you hit groundwater, and the trench starts filling.",
   "pausa": 0.3
  },
  {
   "texto": "So you pump it out day and night, and seal the floor with concrete.",
   "pausa": 0.3
  },
  {
   "texto": "Then you cast a concrete roof over the top and put the street back on it.",
   "pausa": 0.3
  },
  {
   "texto": "Cars drive on top again, and down below, you lay the tracks.",
   "pausa": 0.3
  },
  {
   "texto": "Cut and cover. That's how the first subways in Budapest, Paris and New York were built.",
   "pausa": 0.3
  },
  {
   "texto": "Today, deep lines use tunnel boring machines, but shallow stations are still built this way.",
   "pausa": 0.3
  },
  {
   "texto": "Congratulations! You just built a subway. What should we build next?",
   "pausa": 0.3
  }
 ],
