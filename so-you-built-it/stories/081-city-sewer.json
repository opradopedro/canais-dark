 "autor": "claude",
 "lineas": [
  {
   "texto": "Your city has a million people, and every home dumps its waste in the street.",
   "pausa": 0.3
  },
  {
   "texto": "The stink is awful, and every rain washes it into the river you drink from.",
   "pausa": 0.3
  },
  {
   "texto": "So you dig a channel down the middle of the street to carry it away.",
   "pausa": 0.3
  },
  {
   "texto": "But an open channel still stinks, and it overflows in every storm.",
   "pausa": 0.3
  },
  {
   "texto": "So you bury it: a brick tunnel under the street.",
   "pausa": 0.3
  },
  {
   "texto": "You make it egg-shaped. Narrow at the bottom, so even a trickle flows fast and keeps it clean.",
   "pausa": 0.3
  },
  {
   "texto": "And you connect every building with its own pipe.",
   "pausa": 0.3
  },
  {
   "texto": "But the sewer still dumps everything into the river, right next to the city.",
   "pausa": 0.3
  },
  {
   "texto": "So you send it far downstream, to a plant that cleans it first.",
   "pausa": 0.3
  },
  {
   "texto": "Then a big storm hits, and rainwater pours into the same pipe.",
   "pausa": 0.3
  },
  {
   "texto": "Sewage shoots out of the manholes and floods the streets.",
   "pausa": 0.3
  },
  {
   "texto": "So you build a second pipe, just for rain.",
   "pausa": 0.3
  },
  {
   "texto": "Now the rain goes to the river, and the sewage goes to the plant.",
   "pausa": 0.3
  },
  {
   "texto": "Many old cities still share one pipe, and still overflow in big storms.",
   "pausa": 0.3
  },
  {
   "texto": "Congratulations! You just built a sewer. What should we build next?",
   "pausa": 0.3
  }
 ],
