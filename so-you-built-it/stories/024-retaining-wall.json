 "lineas": [
  {
   "texto": "Your backyard ends in a hill, and you want more flat space.",
   "pausa": 0.3
  },
  {
   "texto": "So you dig the slope straight down and flatten the yard. Problem solved!",
   "pausa": 0.3
  },
  {
   "texto": "But after the first heavy rain, the wet dirt slides right into the yard.",
   "pausa": 0.3
  },
  {
   "texto": "So you build a tall concrete wall to hold the dirt back.",
   "pausa": 0.3
  },
  {
   "texto": "But rain soaks into the hill behind it, and that water pushes on the wall almost twice as hard.",
   "pausa": 0.3
  },
  {
   "texto": "Until one day the whole wall leans forward.",
   "pausa": 0.3
  },
  {
   "texto": "So you fill the space behind it with gravel, and leave holes at the bottom.",
   "pausa": 0.3
  },
  {
   "texto": "Now the water just pours out, and the wall only holds the dirt.",
   "pausa": 0.3
  },
  {
   "texto": "Or skip the concrete: wire baskets full of rocks are heavy and let the water right through.",
   "pausa": 0.3
  },
  {
   "texto": "Congratulations! You just built a retaining wall. What should we build next?",
   "pausa": 0.2
  }
 ],
