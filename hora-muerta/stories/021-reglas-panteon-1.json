 "lineas": [
  {
   "texto": "Doña Marta tiene tres reglas, y esta noche rompió una.",
   "pausa": 0.7
  },
  {
   "texto": "Cuida el panteón de San Juan desde hace treinta años.",
   "pausa": 0.6
  },
  {
   "texto": "Cerrar la reja a las doce, no contestar si la llaman,",
   "pausa": 0.4
  },
  {
   "texto": "y nunca dejar que se apague la vela de la tumba sin nombre.",
   "pausa": 0.8
  },
  {
   "texto": "Esa noche se durmió, y a las tres y diez despertó.",
   "pausa": 0.6
  },
  {
   "texto": "La vela estaba apagada, y en la reja había una nota.",
   "pausa": 0.7
  },
  {
   "texto": "Decía: no contestes, ya estoy adentro.",
   "pausa": 0.8
  },
  {
   "texto": "Era su propia letra.",
   "pausa": 1.0
  },
  {
   "texto": "¿Quién la escribió? Parte dos, mañana, {dia_siguiente}.",
   "pausa": 0.3
  }
 ],
