      "id": "juan",
      "pose": "parado",
      "rosto": "determinado",
      "v": 0.93,
      "esc": 1.0,
      "u": 0.5
     }
    ]
   }
  },
  {
   "texto": "Y si un día cuentas *ocho*, esa noche no duermas.",
   "pausa": 0.5,
   "cena": {
    "fundo": "vila-moinho-dia",
    "cam": {
     "z": [
      1.6,
