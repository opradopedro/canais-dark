    },
    "fx": [],
    "atores": [
     {
      "id": "juan",
      "pose": "parado",
      "rosto": "determinado",
      "v": 0.93,
      "esc": 1.0,
      "u": 0.5
     }
    ]
   }
  },
  {
   "texto": "Cuéntalos al atardecer. Nunca le des la espalda al campo.",
   "pausa": 0.5,
   "cena": {
    "fundo": "vila-alto-dia",
    "cam": {
     "z": [
      1.3,
      1.45
     ],
